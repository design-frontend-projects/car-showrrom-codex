DATABASE_URL="postgresql://postgres:root@localhost:5444/postgres?schema=showroom"

# Auth cookies and sessions
AUTH_SESSION_COOKIE_NAME="cs_session"
AUTH_CSRF_COOKIE_NAME="cs_csrf"
AUTH_COOKIE_DOMAIN=""
AUTH_COOKIE_SECURE="false"
AUTH_COOKIE_SAME_SITE="lax"
AUTH_SESSION_TTL_MINUTES="60"
AUTH_SESSION_REMEMBER_TTL_DAYS="30"
AUTH_SESSION_ROTATE_AFTER_MINUTES="15"

# Use long random values in production. Example:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SESSION_SECRET="change-me-session-secret-at-least-32-bytes"
AUTH_CSRF_SECRET="change-me-csrf-secret-at-least-32-bytes"

# 32-byte base64url value used for AES-256-GCM TOTP secret encryption.
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_ENCRYPTION_KEY="change-me-32-byte-base64url-encryption-key"

# Password hashing and policy
AUTH_PASSWORD_HASH_ROUNDS="8"
AUTH_PASSWORD_MIN_LENGTH="8"

# Demo reset OTP flow
AUTH_RESET_OTP_DIGITS="6"
AUTH_RESET_OTP_TTL_MINUTES="10"
AUTH_RESET_OTP_MAX_ATTEMPTS="5"
AUTH_RESET_TRANSACTION_TTL_MINUTES="15"

# Rate limits
AUTH_RATE_LIMIT_WINDOW_MINUTES="15"
AUTH_LOGIN_RATE_LIMIT_MAX="10"
AUTH_REGISTER_RATE_LIMIT_MAX="10"
AUTH_RESET_RATE_LIMIT_MAX="5"
AUTH_2FA_RATE_LIMIT_MAX="10"

# TOTP 2FA
AUTH_TOTP_ISSUER="Car Showroom"
AUTH_TOTP_WINDOW="1"
AUTH_BACKUP_CODE_COUNT="10"

# Showroom uploads and public media serving
UPLOAD_ROOT=".data/uploads"
SHOWROOM_MAX_IMAGE_BYTES="5242880"
SHOWROOM_MAX_IMAGES_PER_LISTING="12"
SHOWROOM_MEDIA_URL_BASE="/media/listings"
