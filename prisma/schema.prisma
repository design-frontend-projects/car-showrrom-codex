generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model DatabaseHealth {
  id        Int      @id @default(autoincrement())
  checkedAt DateTime @default(now()) @map("checked_at")

  @@map("database_health")
}

model Tenant {
  id              String           @id @default(uuid()) @db.Uuid
  name            String
  slug            String           @unique
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  users           User[]
  roles           Role[]
  permissions     Permission[]
  userRoles       UserRole[]
  rolePermissions RolePermission[]
  carMakes        CarMake[]
  carModels       CarModel[]
  carVariants     CarVariant[]
  vehicleEngines  VehicleEngine[]
  vehicleTransmissions VehicleTransmission[]
  vehicleFuelTypes VehicleFuelType[]
  vehicleBodyTypes VehicleBodyType[]
  vehicleConditions VehicleCondition[]
  vehicleExteriorColors VehicleExteriorColor[]
  vehicleInteriorColors VehicleInteriorColor[]
  carColors       CarColor[]
  carListings     CarListing[]
  listingImages   CarListingImage[]
  priceHistories  CarPriceHistory[]
  modelHistories  CarModelHistory[]
  vehicleRequests VehicleRequest[]
  invitations     UserInvitation[]
  rbacAuditEvents RbacAuditEvent[]

  @@map("tenants")
}

model User {
  id                              String             @id @default(uuid()) @db.Uuid
  tenantId                        String             @map("tenant_id") @db.Uuid
  email                           String
  displayName                     String             @map("display_name")
  passwordHash                    String             @map("password_hash")
  phone                           String?
  avatarUrl                       String?            @map("avatar_url")
  isActive                        Boolean            @default(true) @map("is_active")
  emailVerifiedAt                 DateTime?          @map("email_verified_at")
  passwordChangedAt               DateTime?          @map("password_changed_at")
  twoFactorEnabled                Boolean            @default(false) @map("two_factor_enabled")
  twoFactorRequired               Boolean            @default(false) @map("two_factor_required")
  twoFactorSecretEncrypted        String?            @map("two_factor_secret_encrypted") @db.Text
  twoFactorPendingSecretEncrypted String?            @map("two_factor_pending_secret_encrypted") @db.Text
  twoFactorVerifiedAt             DateTime?          @map("two_factor_verified_at")
  failedLoginCount                Int                @default(0) @map("failed_login_count")
  lockedUntil                     DateTime?          @map("locked_until")
  lastLoginAt                     DateTime?          @map("last_login_at")
  createdAt                       DateTime           @default(now()) @map("created_at")
  updatedAt                       DateTime           @updatedAt @map("updated_at")
  tenant                          Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  roles                           UserRole[]
  sessions                        AuthSession[]
  passwordResetOtps               PasswordResetOtp[]
  backupCodes                     UserBackupCode[]
  carListings                     CarListing[]       @relation("ListingSeller")
  vehicleRequests                 VehicleRequest[]   @relation("VehicleRequestClient")
  reviewedVehicleRequests         VehicleRequest[]   @relation("VehicleRequestReviewer")
  priceHistoryChanges             CarPriceHistory[]  @relation("PriceHistoryChangedBy")
  modelHistoryChanges             CarModelHistory[]  @relation("ModelHistoryChangedBy")
  sentInvitations                  UserInvitation[]   @relation("InvitationInviter")
  acceptedInvitations              UserInvitation[]   @relation("InvitationResultingUser")
  rbacAuditEvents                  RbacAuditEvent[]    @relation("RbacAuditActor")

  @@unique([tenantId, id])
  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([tenantId, email])
  @@index([tenantId, isActive])
  @@index([lockedUntil])
  @@map("users")
}

model AuthSession {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  sessionTokenHash String    @unique @map("session_token_hash")
  csrfTokenHash    String?   @map("csrf_token_hash")
  userAgent        String?   @map("user_agent") @db.Text
  ipAddress        String?   @map("ip_address")
  createdAt        DateTime  @default(now()) @map("created_at")
  lastUsedAt       DateTime? @map("last_used_at")
  rotatedAt        DateTime? @map("rotated_at")
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
  @@map("auth_sessions")
}

model PasswordResetOtp {
  id                   String    @id @default(uuid()) @db.Uuid
  userId               String    @map("user_id") @db.Uuid
  email                String
  otpHash              String    @map("otp_hash")
  resetTransactionHash String?   @unique @map("reset_transaction_hash")
  attempts             Int       @default(0)
  maxAttempts          Int       @default(5) @map("max_attempts")
  expiresAt            DateTime  @map("expires_at")
  transactionExpiresAt DateTime? @map("transaction_expires_at")
  verifiedAt           DateTime? @map("verified_at")
  consumedAt           DateTime? @map("consumed_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([email])
  @@index([expiresAt])
  @@index([consumedAt])
  @@map("password_reset_otps")
}

model UserBackupCode {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @unique @map("code_hash")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([usedAt])
  @@map("user_backup_codes")
}

model Role {
  id              String           @id @default(uuid()) @db.Uuid
  tenantId        String           @map("tenant_id") @db.Uuid
  name            String
  description     String?
  isSystem        Boolean          @default(false) @map("is_system")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users           UserRole[]
  permissions     RolePermission[]

  @@unique([tenantId, id])
  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  tenantId    String           @map("tenant_id") @db.Uuid
  action      String
  description String?
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  roles       RolePermission[]

  @@unique([tenantId, id])
  @@unique([tenantId, action])
  @@index([tenantId])
  @@map("permissions")
}

model UserRole {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at")
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Cascade)
  role       Role     @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, userId, roleId])
  @@index([tenantId])
  @@index([tenantId, userId])
  @@index([tenantId, roleId])
  @@index([userId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  id           String     @id @default(uuid()) @db.Uuid
  tenantId     String     @map("tenant_id") @db.Uuid
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  assignedAt   DateTime   @default(now()) @map("assigned_at")
  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: Cascade)
  permission   Permission @relation(fields: [tenantId, permissionId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, roleId, permissionId])
  @@index([tenantId])
  @@index([tenantId, roleId])
  @@index([tenantId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserInvitation {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  email           String
  normalizedEmail String    @map("normalized_email")
  displayName     String?   @map("display_name")
  tokenHash       String    @unique @map("token_hash")
  targetRoles     Json      @default("[]") @map("target_roles")
  status          String    @default("pending")
  expiresAt       DateTime  @map("expires_at")
  acceptedAt      DateTime? @map("accepted_at")
  revokedAt       DateTime? @map("revoked_at")
  resentAt        DateTime? @map("resent_at")
  inviterUserId   String    @map("inviter_user_id") @db.Uuid
  resultingUserId String?   @map("resulting_user_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  inviter         User      @relation("InvitationInviter", fields: [tenantId, inviterUserId], references: [tenantId, id], onDelete: Cascade)
  resultingUser   User?     @relation("InvitationResultingUser", fields: [tenantId, resultingUserId], references: [tenantId, id], onDelete: NoAction)

  @@unique([tenantId, id])
  @@index([tenantId, status, expiresAt])
  @@index([tenantId, normalizedEmail])
  @@index([tenantId, inviterUserId])
  @@index([tenantId, resultingUserId])
  @@map("user_invitations")
}

model RbacAuditEvent {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  actorUserId  String?  @map("actor_user_id") @db.Uuid
  action       String
  targetType   String   @map("target_type")
  targetId     String?  @map("target_id") @db.Uuid
  metadata     Json     @default("{}")
  createdAt    DateTime @default(now()) @map("created_at")
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actor        User?    @relation("RbacAuditActor", fields: [tenantId, actorUserId], references: [tenantId, id], onDelete: NoAction)

  @@unique([tenantId, id])
  @@index([tenantId, createdAt])
  @@index([tenantId, actorUserId])
  @@index([tenantId, action])
  @@index([tenantId, targetType, targetId])
  @@map("rbac_audit_events")
}

enum CarListingStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  INACTIVE
  REJECTED
  SOLD
  ARCHIVED
  DELETED
}

enum CarListingCondition {
  NEW
  CERTIFIED_PRE_OWNED
  USED
  DAMAGED
}

enum CarFuelType {
  PETROL
  DIESEL
  HYBRID
  PLUG_IN_HYBRID
  ELECTRIC
  LPG
  OTHER
}

enum CarTransmissionType {
  AUTOMATIC
  MANUAL
  CVT
  DUAL_CLUTCH
  OTHER
}

enum CarBodyType {
  SEDAN
  SUV
  COUPE
  HATCHBACK
  CONVERTIBLE
  WAGON
  PICKUP
  VAN
  CROSSOVER
  OTHER
}

enum VehicleRequestStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum ImageProvider {
  LOCAL
}

model CarMake {
  id             String       @id @default(uuid()) @db.Uuid
  tenantId       String       @map("tenant_id") @db.Uuid
  name           String
  normalizedName String       @map("normalized_name")
  country        String?
  isActive       Boolean      @default(true) @map("is_active")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  models         CarModel[]
  listings       CarListing[]

  @@unique([tenantId, id])
  @@unique([tenantId, normalizedName])
  @@index([tenantId, isActive])
  @@map("car_makes")
}

model CarModel {
  id             String       @id @default(uuid()) @db.Uuid
  tenantId       String       @map("tenant_id") @db.Uuid
  makeId         String       @map("make_id") @db.Uuid
  name           String
  normalizedName String       @map("normalized_name")
  productionFrom Int?         @map("production_from")
  productionTo   Int?         @map("production_to")
  isActive       Boolean      @default(true) @map("is_active")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  make           CarMake      @relation(fields: [tenantId, makeId], references: [tenantId, id], onDelete: Cascade)
  variants       CarVariant[]
  listings       CarListing[]

  @@unique([tenantId, id])
  @@unique([tenantId, makeId, normalizedName])
  @@index([tenantId, makeId])
  @@index([tenantId, isActive])
  @@map("car_models")
}

model CarVariant {
  id             String              @id @default(uuid()) @db.Uuid
  tenantId       String              @map("tenant_id") @db.Uuid
  modelId        String              @map("model_id") @db.Uuid
  engineId       String?             @map("engine_id") @db.Uuid
  transmissionId String?             @map("transmission_id") @db.Uuid
  fuelTypeId     String?             @map("fuel_type_id") @db.Uuid
  bodyTypeId     String?             @map("body_type_id") @db.Uuid
  name           String
  normalizedName String              @map("normalized_name")
  bodyType       CarBodyType         @map("body_type")
  fuelType       CarFuelType         @map("fuel_type")
  transmission   CarTransmissionType
  driveTrain     String?             @map("drive_train")
  isActive       Boolean             @default(true) @map("is_active")
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")
  tenant         Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  model          CarModel            @relation(fields: [tenantId, modelId], references: [tenantId, id], onDelete: Cascade)
  engine         VehicleEngine?      @relation(fields: [tenantId, engineId], references: [tenantId, id], onDelete: NoAction)
  transmissionCatalog VehicleTransmission? @relation(fields: [tenantId, transmissionId], references: [tenantId, id], onDelete: NoAction)
  fuelTypeCatalog VehicleFuelType?   @relation(fields: [tenantId, fuelTypeId], references: [tenantId, id], onDelete: NoAction)
  bodyTypeCatalog VehicleBodyType?   @relation(fields: [tenantId, bodyTypeId], references: [tenantId, id], onDelete: NoAction)
  listings       CarListing[]

  @@unique([tenantId, id])
  @@unique([tenantId, modelId, normalizedName])
  @@index([tenantId, modelId])
  @@index([tenantId, engineId])
  @@index([tenantId, transmissionId])
  @@index([tenantId, fuelTypeId])
  @@index([tenantId, bodyTypeId])
  @@index([tenantId, bodyType, fuelType, transmission])
  @@index([tenantId, isActive])
  @@map("car_variants")
}

model CarColor {
  id                       String       @id @default(uuid()) @db.Uuid
  tenantId                 String       @map("tenant_id") @db.Uuid
  name                     String
  normalizedName           String       @map("normalized_name")
  hexCode                  String?      @map("hex_code")
  createdAt                DateTime     @default(now()) @map("created_at")
  updatedAt                DateTime     @updatedAt @map("updated_at")
  tenant                   Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@unique([tenantId, normalizedName])
  @@index([tenantId])
  @@map("car_colors")
}

model VehicleExteriorColor {
  id                    String       @id @default(uuid()) @db.Uuid
  tenantId              String       @map("tenant_id") @db.Uuid
  name                  String
  normalizedName        String       @map("normalized_name")
  hexCode               String?      @map("hex_code")
  localizedNames        Json         @default("{}") @map("localized_names")
  isActive              Boolean      @default(true) @map("is_active")
  sortOrder             Int          @default(0) @map("sort_order")
  createdAt             DateTime     @default(now()) @map("created_at")
  updatedAt             DateTime     @updatedAt @map("updated_at")
  tenant                Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  exteriorColorListings CarListing[] @relation("ExteriorVehicleColor")

  @@unique([tenantId, id])
  @@unique([tenantId, normalizedName])
  @@index([tenantId, isActive, sortOrder])
  @@map("vehicle_exterior_colors")
}

model VehicleInteriorColor {
  id                    String       @id @default(uuid()) @db.Uuid
  tenantId              String       @map("tenant_id") @db.Uuid
  name                  String
  normalizedName        String       @map("normalized_name")
  hexCode               String?      @map("hex_code")
  localizedNames        Json         @default("{}") @map("localized_names")
  isActive              Boolean      @default(true) @map("is_active")
  sortOrder             Int          @default(0) @map("sort_order")
  createdAt             DateTime     @default(now()) @map("created_at")
  updatedAt             DateTime     @updatedAt @map("updated_at")
  tenant                Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  interiorColorListings CarListing[] @relation("InteriorVehicleColor")

  @@unique([tenantId, id])
  @@unique([tenantId, normalizedName])
  @@index([tenantId, isActive, sortOrder])
  @@map("vehicle_interior_colors")
}

model VehicleEngine {
  id             String       @id @default(uuid()) @db.Uuid
  tenantId       String       @map("tenant_id") @db.Uuid
  name           String
  normalizedName String       @map("normalized_name")
  code           String?
  description    String?
  localizedNames Json         @default("{}") @map("localized_names")
  isActive       Boolean      @default(true) @map("is_active")
  sortOrder      Int          @default(0) @map("sort_order")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  variants       CarVariant[]

  @@unique([tenantId, id])
  @@unique([tenantId, normalizedName])
  @@unique([tenantId, code])
  @@index([tenantId, isActive, sortOrder])
  @@map("vehicle_engines")
}

model VehicleTransmission {
  id             String       @id @default(uuid()) @db.Uuid
  tenantId       String       @map("tenant_id") @db.Uuid
  name           String
  normalizedName String       @map("normalized_name")
  code           String?
  description    String?
  localizedNames Json         @default("{}") @map("localized_names")
  isActive       Boolean      @default(true) @map("is_active")
  sortOrder      Int          @default(0) @map("sort_order")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  variants       CarVariant[]

  @@unique([tenantId, id])
  @@unique([tenantId, normalizedName])
  @@unique([tenantId, code])
  @@index([tenantId, isActive, sortOrder])
  @@map("vehicle_transmissions")
}

model VehicleFuelType {
  id             String       @id @default(uuid()) @db.Uuid
  tenantId       String       @map("tenant_id") @db.Uuid
  name           String
  normalizedName String       @map("normalized_name")
  code           String?
  description    String?
  localizedNames Json         @default("{}") @map("localized_names")
  isActive       Boolean      @default(true) @map("is_active")
  sortOrder      Int          @default(0) @map("sort_order")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  variants       CarVariant[]

  @@unique([tenantId, id])
  @@unique([tenantId, normalizedName])
  @@unique([tenantId, code])
  @@index([tenantId, isActive, sortOrder])
  @@map("vehicle_fuel_types")
}

model VehicleBodyType {
  id             String       @id @default(uuid()) @db.Uuid
  tenantId       String       @map("tenant_id") @db.Uuid
  name           String
  normalizedName String       @map("normalized_name")
  code           String?
  description    String?
  localizedNames Json         @default("{}") @map("localized_names")
  isActive       Boolean      @default(true) @map("is_active")
  sortOrder      Int          @default(0) @map("sort_order")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  variants       CarVariant[]

  @@unique([tenantId, id])
  @@unique([tenantId, normalizedName])
  @@unique([tenantId, code])
  @@index([tenantId, isActive, sortOrder])
  @@map("vehicle_body_types")
}

model VehicleCondition {
  id             String       @id @default(uuid()) @db.Uuid
  tenantId       String       @map("tenant_id") @db.Uuid
  name           String
  normalizedName String       @map("normalized_name")
  code           String?
  description    String?
  localizedNames Json         @default("{}") @map("localized_names")
  isActive       Boolean      @default(true) @map("is_active")
  sortOrder      Int          @default(0) @map("sort_order")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  listings       CarListing[]

  @@unique([tenantId, id])
  @@unique([tenantId, normalizedName])
  @@unique([tenantId, code])
  @@index([tenantId, isActive, sortOrder])
  @@map("vehicle_conditions")
}

model CarListing {
  id                    String              @id @default(uuid()) @db.Uuid
  tenantId              String              @map("tenant_id") @db.Uuid
  sellerUserId          String              @map("seller_user_id") @db.Uuid
  makeId                String              @map("make_id") @db.Uuid
  modelId               String              @map("model_id") @db.Uuid
  variantId             String              @map("variant_id") @db.Uuid
  conditionId           String?             @map("condition_id") @db.Uuid
  exteriorColorId       String?             @map("exterior_color_id") @db.Uuid
  interiorColorId       String?             @map("interior_color_id") @db.Uuid
  title                 String
  slug                  String
  vin                   String?
  modelYear             Int                 @map("model_year")
  price                 Decimal             @db.Decimal(12, 2)
  currency              String              @default("USD") @db.VarChar(3)
  mileage               Int
  condition             CarListingCondition
  exteriorColorName     String?             @map("exterior_color_name")
  interiorColorName     String?             @map("interior_color_name")
  location              String
  description           String              @db.Text
  status                CarListingStatus    @default(DRAFT)
  publishedAt           DateTime?           @map("published_at")
  soldAt                DateTime?           @map("sold_at")
  archivedAt            DateTime?           @map("archived_at")
  createdAt             DateTime            @default(now()) @map("created_at")
  updatedAt             DateTime            @updatedAt @map("updated_at")
  tenant                Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  seller                User                @relation("ListingSeller", fields: [tenantId, sellerUserId], references: [tenantId, id], onDelete: Cascade)
  make                  CarMake             @relation(fields: [tenantId, makeId], references: [tenantId, id], onDelete: Restrict)
  model                 CarModel            @relation(fields: [tenantId, modelId], references: [tenantId, id], onDelete: Restrict)
  variant               CarVariant          @relation(fields: [tenantId, variantId], references: [tenantId, id], onDelete: Restrict)
  conditionCatalog      VehicleCondition?   @relation(fields: [tenantId, conditionId], references: [tenantId, id], onDelete: NoAction)
  exteriorColor         VehicleExteriorColor? @relation("ExteriorVehicleColor", fields: [tenantId, exteriorColorId], references: [tenantId, id], onDelete: NoAction)
  interiorColor         VehicleInteriorColor? @relation("InteriorVehicleColor", fields: [tenantId, interiorColorId], references: [tenantId, id], onDelete: NoAction)
  images                CarListingImage[]
  priceHistory          CarPriceHistory[]
  modelHistory          CarModelHistory[]

  @@unique([tenantId, id])
  @@unique([tenantId, slug])
  @@index([tenantId, status, price])
  @@index([tenantId, status, modelYear])
  @@index([tenantId, status, mileage])
  @@index([tenantId, sellerUserId, status])
  @@index([tenantId, makeId, modelId, variantId])
  @@index([tenantId, conditionId])
  @@index([tenantId, exteriorColorId])
  @@index([tenantId, interiorColorId])
  @@index([tenantId, location])
  @@index([updatedAt])
  @@map("car_listings")
}

model CarListingImage {
  id           String        @id @default(uuid()) @db.Uuid
  tenantId     String        @map("tenant_id") @db.Uuid
  listingId    String        @map("listing_id") @db.Uuid
  provider     ImageProvider @default(LOCAL)
  storageKey   String        @unique @map("storage_key")
  originalName String        @map("original_name")
  mimeType     String        @map("mime_type")
  byteSize     Int           @map("byte_size")
  width        Int?
  height       Int?
  sortOrder    Int           @default(0) @map("sort_order")
  isPrimary    Boolean       @default(false) @map("is_primary")
  altText      String?       @map("alt_text")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  listing      CarListing    @relation(fields: [tenantId, listingId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, listingId, sortOrder])
  @@index([tenantId, listingId])
  @@index([tenantId, listingId, isPrimary])
  @@map("car_listing_images")
}

model CarPriceHistory {
  id              String     @id @default(uuid()) @db.Uuid
  tenantId        String     @map("tenant_id") @db.Uuid
  listingId       String     @map("listing_id") @db.Uuid
  oldPrice        Decimal    @map("old_price") @db.Decimal(12, 2)
  newPrice        Decimal    @map("new_price") @db.Decimal(12, 2)
  currency        String     @db.VarChar(3)
  changedByUserId String?    @map("changed_by_user_id") @db.Uuid
  reason          String?
  createdAt       DateTime   @default(now()) @map("created_at")
  tenant          Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  listing         CarListing @relation(fields: [tenantId, listingId], references: [tenantId, id], onDelete: Cascade)
  changedBy       User?      @relation("PriceHistoryChangedBy", fields: [tenantId, changedByUserId], references: [tenantId, id], onDelete: NoAction)

  @@index([tenantId, listingId, createdAt])
  @@index([tenantId, changedByUserId])
  @@map("car_price_histories")
}

model CarModelHistory {
  id              String     @id @default(uuid()) @db.Uuid
  tenantId        String     @map("tenant_id") @db.Uuid
  listingId       String     @map("listing_id") @db.Uuid
  oldMakeId       String?    @map("old_make_id") @db.Uuid
  newMakeId       String?    @map("new_make_id") @db.Uuid
  oldModelId      String?    @map("old_model_id") @db.Uuid
  newModelId      String?    @map("new_model_id") @db.Uuid
  oldVariantId    String?    @map("old_variant_id") @db.Uuid
  newVariantId    String?    @map("new_variant_id") @db.Uuid
  oldModelYear    Int?       @map("old_model_year")
  newModelYear    Int?       @map("new_model_year")
  diff            Json
  changedByUserId String?    @map("changed_by_user_id") @db.Uuid
  reason          String?
  createdAt       DateTime   @default(now()) @map("created_at")
  tenant          Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  listing         CarListing @relation(fields: [tenantId, listingId], references: [tenantId, id], onDelete: Cascade)
  changedBy       User?      @relation("ModelHistoryChangedBy", fields: [tenantId, changedByUserId], references: [tenantId, id], onDelete: NoAction)

  @@index([tenantId, listingId, createdAt])
  @@index([tenantId, changedByUserId])
  @@map("car_model_histories")
}

model VehicleRequest {
  id               String               @id @default(uuid()) @db.Uuid
  tenantId         String               @map("tenant_id") @db.Uuid
  clientUserId     String               @map("client_user_id") @db.Uuid
  preferredMake    String?              @map("preferred_make")
  preferredModel   String?              @map("preferred_model")
  preferredVariant String?              @map("preferred_variant")
  modelYearMin     Int?                 @map("model_year_min")
  modelYearMax     Int?                 @map("model_year_max")
  budgetMin        Decimal?             @map("budget_min") @db.Decimal(12, 2)
  budgetMax        Decimal?             @map("budget_max") @db.Decimal(12, 2)
  currency         String               @default("USD") @db.VarChar(3)
  contactPreference String              @default("email") @map("contact_preference")
  notes            String?              @db.Text
  status           VehicleRequestStatus @default(PENDING_REVIEW)
  reviewerUserId   String?              @map("reviewer_user_id") @db.Uuid
  decisionNote     String?              @map("decision_note") @db.Text
  reviewedAt       DateTime?            @map("reviewed_at")
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")
  tenant           Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client           User                 @relation("VehicleRequestClient", fields: [tenantId, clientUserId], references: [tenantId, id], onDelete: Cascade)
  reviewer         User?                @relation("VehicleRequestReviewer", fields: [tenantId, reviewerUserId], references: [tenantId, id], onDelete: NoAction)

  @@unique([tenantId, id])
  @@index([tenantId, clientUserId, status])
  @@index([tenantId, status, createdAt])
  @@index([tenantId, reviewerUserId])
  @@map("vehicle_requests")
}
